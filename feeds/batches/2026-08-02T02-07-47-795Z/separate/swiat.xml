      <media:thumbnail url="https://www.pap.pl/sites/default/files/styles/srednie_zdjecie_675x380/public/202608/pap_20260707_2JC.jpg.webp?itok=5xUI1eO9"/>
      <source url="https://www.pap.pl/swiat">PAP.pl - Swiat</source>
