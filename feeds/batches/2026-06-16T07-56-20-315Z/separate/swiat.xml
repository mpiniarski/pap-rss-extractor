      <media:thumbnail url="https://www.pap.pl/sites/default/files/styles/srednie_zdjecie_675x380/public/202606/pap_20260615_1OJ.jpg.webp?itok=6YMtcCV9"/>
      <source url="https://www.pap.pl/swiat">PAP.pl - Swiat</source>
      <pubDate>Tue, 16 Jun 2026 05:38:38 GMT</pubDate>
