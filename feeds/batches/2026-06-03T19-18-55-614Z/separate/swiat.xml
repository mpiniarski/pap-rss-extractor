      <media:thumbnail url="https://www.pap.pl/sites/default/files/styles/srednie_zdjecie_675x380/public/202606/AH1Z_at_the_MCAS_Miramar_Air_Show_on_3_Oct_2008.jpg.webp?itok=XeMZdUOd"/>
