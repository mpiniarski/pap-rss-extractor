      <media:thumbnail url="https://www.pap.pl/sites/default/files/styles/srednie_zdjecie_675x380/public/202607/pap_20230719_16D.jpg.webp?itok=gXsF4Nqi"/>
      <source url="https://www.pap.pl/fact-checking">PAP.pl - Fact-checking</source>
      <pubDate>Tue, 07 Jul 2026 13:06:20 GMT</pubDate>
