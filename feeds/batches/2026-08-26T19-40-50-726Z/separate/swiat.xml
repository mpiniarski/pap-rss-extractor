      <media:thumbnail url="https://www.pap.pl/sites/default/files/styles/srednie_zdjecie_675x380/public/202608/pap_20191005_16L.jpg.webp?itok=5masc-jE"/>
      <source url="https://www.pap.pl/swiat">PAP.pl - Swiat</source>
      <pubDate>Wed, 26 Aug 2026 17:16:18 GMT</pubDate>
