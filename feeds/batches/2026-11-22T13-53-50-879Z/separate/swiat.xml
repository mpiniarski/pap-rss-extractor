      <media:thumbnail url="https://www.pap.pl/sites/default/files/styles/srednie_zdjecie_675x380/public/202611/image%20%2840%29.png.webp?itok=tgpQhb1S"/>
      <source url="https://www.pap.pl/swiat">PAP.pl - Swiat</source>
      <pubDate>Sun, 22 Nov 2026 13:32:00 GMT</pubDate>
