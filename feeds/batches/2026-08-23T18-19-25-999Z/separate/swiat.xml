      <media:thumbnail url="https://www.pap.pl/sites/default/files/styles/srednie_zdjecie_675x380/public/202608/epa13186122.jpg.webp?itok=TIj8yesx"/>
      <source url="https://www.pap.pl/swiat">PAP.pl - Swiat</source>
