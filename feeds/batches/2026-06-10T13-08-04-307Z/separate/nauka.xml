      <media:thumbnail url="https://www.pap.pl/sites/default/files/styles/srednie_zdjecie_675x380/public/202606/pap_20260405_1LE.jpg.webp?itok=0zUCxzsM"/>
      <source url="https://www.pap.pl/nauka">PAP.pl - Nauka</source>
