      <media:thumbnail url="https://www.pap.pl/sites/default/files/styles/srednie_zdjecie_675x380/public/202609/pap_20260918_18N.jpg.webp?itok=Z7T3vdWs"/>
      <source url="https://www.pap.pl/swiat">PAP.pl - Swiat</source>
      <pubDate>Thu, 24 Sep 2026 20:50:00 GMT</pubDate>
