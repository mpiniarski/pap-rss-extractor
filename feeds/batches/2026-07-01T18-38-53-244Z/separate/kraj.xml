      <media:thumbnail url="https://www.pap.pl/sites/default/files/styles/srednie_zdjecie_675x380/public/202607/pap_20260529_0VV%20%281%29.jpg.webp?itok=ksM8IcAm"/>
      <source url="https://www.pap.pl/kraj">PAP.pl - Kraj</source>
      <pubDate>Wed, 01 Jul 2026 18:18:00 GMT</pubDate>
