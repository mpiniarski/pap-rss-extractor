      <media:thumbnail url="https://www.pap.pl/sites/default/files/styles/srednie_zdjecie_675x380/public/202608/pap_20260723_0XO.jpg.webp?itok=dKcnK77W"/>
      <source url="https://www.pap.pl/swiat">PAP.pl - Swiat</source>
      <pubDate>Sat, 22 Aug 2026 12:09:57 GMT</pubDate>
