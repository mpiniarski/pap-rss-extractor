      <media:thumbnail url="https://www.pap.pl/sites/default/files/styles/srednie_zdjecie_675x380/public/202606/pap_20260602_166.jpg.webp?itok=RQWuZ-Cs"/>
      <source url="https://www.pap.pl/gospodarka">PAP.pl - Gospodarka</source>
      <pubDate>Tue, 02 Jun 2026 13:12:00 GMT</pubDate>
