      <media:thumbnail url="https://www.pap.pl/sites/default/files/styles/srednie_zdjecie_675x380/public/202608/v-i-fbc4af1c-06a3-4476-9a83-15b53dc73839-2.jpg.webp?itok=eUuECTR0"/>
