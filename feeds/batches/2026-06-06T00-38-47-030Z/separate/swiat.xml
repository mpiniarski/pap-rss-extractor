      <media:thumbnail url="https://www.pap.pl/sites/default/files/styles/srednie_zdjecie_675x380/public/202606/pap_20230615_1DX.jpg.webp?h=82d96eab&amp;itok=DWg4KjXo"/>
      <source url="https://www.pap.pl/swiat">PAP.pl - Swiat</source>
      <pubDate>Fri, 05 Jun 2026 17:09:36 GMT</pubDate>
