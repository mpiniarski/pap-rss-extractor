      <media:thumbnail url="https://www.pap.pl/sites/default/files/styles/srednie_zdjecie_675x380/public/202606/pap_20250423_27L.jpg.webp?itok=q4JOnliP"/>
      <source url="https://www.pap.pl/swiat">PAP.pl - Swiat</source>
      <pubDate>Sun, 21 Jun 2026 16:24:26 GMT</pubDate>
