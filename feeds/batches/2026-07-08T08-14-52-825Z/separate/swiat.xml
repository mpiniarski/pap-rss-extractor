      <media:thumbnail url="https://www.pap.pl/sites/default/files/styles/srednie_zdjecie_675x380/public/202607/pap_20260708_04T.jpg.webp?itok=k-uODzjp"/>
      <source url="https://www.pap.pl/swiat">PAP.pl - Swiat</source>
      <pubDate>Wed, 08 Jul 2026 06:45:02 GMT</pubDate>
