      <media:thumbnail url="https://www.pap.pl/sites/default/files/styles/srednie_zdjecie_675x380/public/202608/pap_20260702_1AY.jpg.webp?itok=tmBKnX2I"/>
      <source url="https://www.pap.pl/sport">PAP.pl - Sport</source>
