      <media:thumbnail url="https://www.pap.pl/sites/default/files/styles/srednie_zdjecie_675x380/public/202609/pap_20230708_0DE.jpg.webp?itok=KwqY4dD_"/>
      <source url="https://www.pap.pl/swiat">PAP.pl - Swiat</source>
