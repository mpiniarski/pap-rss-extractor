      <media:thumbnail url="https://www.pap.pl/sites/default/files/styles/srednie_zdjecie_675x380/public/202608/pap_20260411_1KC.jpg.webp?itok=j0taBlXE"/>
      <source url="https://www.pap.pl/fact-checking">PAP.pl - Fact-checking</source>
      <pubDate>Mon, 24 Aug 2026 03:14:00 GMT</pubDate>
