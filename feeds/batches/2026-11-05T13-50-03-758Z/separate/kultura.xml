      <media:thumbnail url="https://www.pap.pl/sites/default/files/styles/srednie_zdjecie_675x380/public/202611/v-i-ab391c57-4671-47ae-95af-5d4b074a7760-3.jpg.webp?itok=KTrvj_UD"/>
