      <media:thumbnail url="https://www.pap.pl/sites/default/files/styles/srednie_zdjecie_675x380/public/202606/pap_20260216_260.jpg.webp?itok=Ja21fZeA"/>
      <source url="https://www.pap.pl/gospodarka">PAP.pl - Gospodarka</source>
      <pubDate>Tue, 02 Jun 2026 19:20:14 GMT</pubDate>
