      <media:thumbnail url="https://www.pap.pl/sites/default/files/styles/srednie_zdjecie_675x380/public/202608/26807398.jpg.webp?itok=RRugqSsK"/>
      <source url="https://www.pap.pl/sport">PAP.pl - Sport</source>
      <pubDate>Sun, 09 Aug 2026 17:09:08 GMT</pubDate>
