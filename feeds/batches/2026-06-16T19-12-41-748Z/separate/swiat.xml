      <media:thumbnail url="https://www.pap.pl/sites/default/files/styles/srednie_zdjecie_675x380/public/202606/za%C5%82%20trump.jpg.webp?itok=40QKqTQJ"/>
      <source url="https://www.pap.pl/swiat">PAP.pl - Swiat</source>
      <pubDate>Tue, 16 Jun 2026 17:08:33 GMT</pubDate>
    </item>
